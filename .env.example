# ==============================================================================
# MedCore AI - Smart Clinic & Telemedicine Platform
# Environment Configuration Template
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Gemini AI Clinical Triage & Doctor Copilot
# Get your API key at: https://aistudio.google.com/app/apikey
# If left empty, MedCore AI automatically uses its intelligent built-in clinical triage fallback engine
GEMINI_API_KEY=""

# Gmail SMTP Email Notifications (Nodemailer)
# Configure to enable live HTML appointment confirmation & cancellation emails
# If left empty, email sending is safely skipped and logged to console
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-clinic@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="MedCore AI Clinic <no-reply@medcore.ai>"

# Optional Database URL (MongoDB / Prisma)
# If left empty, MedCore AI runs flawlessly on its embedded zero-setup persistent JSON data layer
DATABASE_URL=""
